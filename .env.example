# Copy this file to .env and paste your token in.
# Get one at https://huggingface.co/settings/tokens (a read token is enough).
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Stops sentence-transformers from re-downloading weights if you
# already keep a cache somewhere else.
# HF_HOME=D:/hf_cache

# Optional. Silences the tokenizers fork warning on Linux.
TOKENIZERS_PARALLELISM=false
